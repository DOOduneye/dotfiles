# ~/.Brewfile — install everything with `brew bundle --global install`
#
# Layer 1 and 2 of the install model live here (see SETUP.md):
#   casks    = GUI applications
#   formulae = machine-wide CLI tools you always want at latest
#
# Language runtimes are deliberately absent. node, python, go, postgres and
# friends belong in a project's .mise.toml so two repos can disagree about
# versions. If you find yourself adding one here, that is the signal it should
# have been a project dependency.

# No taps. Every package below is in homebrew/core or homebrew/cask, so this
# file has no third-party dependencies to go stale.

# === Shell and prompt ===
brew "fish"
brew "starship"
brew "tmux"

# === Dotfile and version management ===
brew "chezmoi"
brew "mise"

# === Git ===
brew "git"
brew "gh"
brew "lazygit"       # tmux prefix+g opens this in a popup
brew "difftastic"    # .gitconfig sets diff.external = difft

# === Shell tooling referenced by config.fish ===
brew "zoxide"        # aliased to `cd`
brew "atuin"         # history, bound to the up arrow
brew "fzf"
brew "bat"           # aliased to `cat`
brew "eza"           # aliased to `ls`
brew "fd"            # aliased to `find`
brew "direnv"        # per-project env vars, keeps secrets out of this repo
brew "ripgrep"       # nvim telescope depends on this

# === Neovim toolchain ===
# The nvim config uses Neovim's built-in vim.lsp.enable and vim.pack rather
# than Mason and lazy.nvim, so the server binaries have to come from here.
# Without them nvim still opens, it just has no language support.
brew "tree-sitter-cli"                 # compiles treesitter parsers. NOT the
                                       # `tree-sitter` formula, which is the
                                       # library and installs no binary
brew "lua-language-server"
brew "gopls"
brew "pyright"
brew "typescript-language-server"
brew "tailwindcss-language-server"
brew "vscode-langservers-extracted"    # provides jsonls, html, css
brew "yaml-language-server"
brew "dockerfile-language-server"
brew "marksman"                        # markdown

# === General utilities ===
brew "tree"
brew "xh"
brew "ffmpeg"

# === Fonts ===
cask "font-jetbrains-mono-nerd-font"   # starship and nvim need the glyphs

# === Terminal and editors ===
cask "ghostty"
cask "zed"

# === Everyday applications ===
cask "raycast"
cask "obsidian"
cask "google-chrome"
cask "hiddenbar"
cask "appcleaner"

{{ if .installAI -}}
# === AI tools ===
cask "claude"
cask "chatgpt"
cask "codex"
{{ end -}}

{{ if .installComms -}}
# === Communication ===
cask "slack"
cask "zoom"
{{ end -}}

{{ if .installMedia -}}
# === Media ===
cask "spotify"
{{ end -}}

{{ if .installOllama -}}
# === Local models ===
cask "ollama"
{{ end -}}

{{ if .installBitwarden -}}
# === Password manager ===
cask "bitwarden"
{{ end -}}
